---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FormulaireProfil from '@/components/profil/FormulaireProfil';
---

<BaseLayout
  title="Mon profil — RouleurLab"
  description="Renseignez votre poids, votre niveau et votre FTP pour affiner les calculateurs de pacing et de nutrition. Aucun compte requis."
