---
import BaseLayout from '../layouts/BaseLayout.astro';

// Accueil — refonte visuelle (retour utilisateur 20/08/2026) : la version
// précédente était une simple liste de liens soulignés, tous de même poids
// visuel, avec un message "site en construction" trompeur (tous les outils
// du MVP sont en ligne et fonctionnels). Remplacée par des cartes groupées
// par catégorie, avec pictogramme par outil pour la reconnaissance rapide,
// et un outil "vedette" mis en avant (Préparer ma sortie, qui combine les
// deux outils course en une fiche). Palette et thème inchangés (sombre +
// accent orange) — seule la hiérarchie et la mise en page évoluent.

// Descriptions homepage volontairement plus incitatives que sur les pages
// outils elles-mêmes (registre neutre/sourcé conservé là-bas) — convention
// classique page d'accueil vs. page de destination. Chaque accroche reste
// factuellement exacte (pas de chiffre inventé, pas de fonctionnalité prêtée
// à l'outil qu'il n'a pas — ex. le pacing est un plan calculé à l'avance,
// pas un suivi en temps réel pendant l'effort).
const outilsMecanique = [
  {
    href: '/outils/mecanique/couple-de-serrage',
    titre: 'Couple de serrage vélo',
    description: 'Ne serrez plus au pif : les valeurs de couple pour chaque pièce clé (potence, cassette, disque, pédalier…), sourcées et avec leurs limites d’usage.',
    icone: 'serrage',
  },
  {
    href: '/outils/mecanique/longueur-chaine',
    titre: 'Longueur de chaîne',
    description: 'Le bon nombre de maillons sans y passer la soirée, à partir de vos bases, plateaux et cassette — pré-rempli automatiquement si votre vélo est dans le garage.',
    icone: 'chaine',
  },
  {
    href: '/outils/mecanique/compatibilite-pneu-jante',
    titre: 'Compatibilité pneu/jante',
    description: 'Évitez la mauvaise surprise pneu/jante : plage recommandée et plage tolérée (ETRTO) selon votre jante, règle hookless comprise.',
    icone: 'roue',
  },
  {
    href: '/outils/mecanique/compatibilite-cassette-derailleur',
    titre: 'Cassette / dérailleur',
    description: 'Avant de monter une cassette plus large, vérifiez que votre dérailleur suit : pignon maximum et capacité totale calculés pour votre config.',
    icone: 'cassette',
  },
];

const outilsCourse = [
  {
    href: '/outils/course/pacing',
    titre: 'Plan de puissance',
    description: "Ne cramez pas vos jambes trop tôt : une puissance cible par tronçon de votre parcours, calculée depuis votre FTP, avec suivi de votre réserve anaérobie (W'balance).",
    icone: 'eclair',
  },
  {
    href: '/outils/course/nutrition',
    titre: 'Plan nutrition course',
    description: 'Anticipez la fringale avant qu’elle n’arrive : vos repères de glucides, hydratation et sodium par heure d’effort, ajustés à la durée, l’intensité et la chaleur prévues.',
    icone: 'goutte',
  },
];

const outilVedette = {
  href: '/outils/course/preparer-ma-sortie',
  titre: 'Préparer ma sortie ou ma course',
  description: 'Un seul formulaire, une fiche prête pour la route : votre plan de puissance et votre plan nutrition combinés, calculés en une seule saisie.',
  icone: 'fiche',
};
---

<BaseLayout
  title="RouleurLab — outils gratuits pour cyclistes"
  description="Calculateurs de compatibilité mécanique et outils de préparation de course pour cyclistes, gratuits et sourcés."
>
  <section class="hero">
    <h1>RouleurLab</h1>
    <p class="hero-intro">
      Des calculateurs gratuits et sourcés pour la mécanique vélo et la préparation de course —
      sans compte obligatoire, sans publicité.
    </p>
  </section>

  <section class="section-outils" aria-labelledby="titre-mecanique">
    <h2 id="titre-mecanique">
      <svg class="titre-icone" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5 19 7.5v9L12 20.5 5 16.5v-9z" /><circle cx="12" cy="12" r="3" /></svg>
      Mécanique
    </h2>
    <div class="grille-outils">
      {outilsMecanique.map((outil) => (
        <a class="carte-outil" href={outil.href}>
          <span class="carte-outil-icone" data-icone={outil.icone} aria-hidden="true">
            {outil.icone === 'serrage' && (
              <svg viewBox="0 0 24 24"><path d="M12 3.5 19 7.5v9L12 20.5 5 16.5v-9z" /><circle cx="12" cy="12" r="3" /></svg>
            )}
            {outil.icone === 'chaine' && (
              <svg viewBox="0 0 24 24">
                <rect x="1" y="9" width="8" height="6" rx="3" />
                <rect x="8" y="9" width="8" height="6" rx="3" />
                <rect x="15" y="9" width="8" height="6" rx="3" />
                <circle cx="8.5" cy="12" r="0.9" fill="currentColor" stroke="none" />
                <circle cx="15.5" cy="12" r="0.9" fill="currentColor" stroke="none" />
              </svg>
            )}
            {outil.icone === 'roue' && (
              <svg viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="9.3" stroke-width="2.2" />
                <circle cx="12" cy="12" r="6.8" />
                <circle cx="12" cy="12" r="1.5" />
                <path d="M12 5.2v5.3M12 13.5v5.3M5.2 12h5.3M13.5 12h5.3" />
              </svg>
            )}
            {outil.icone === 'cassette' && (
              <svg viewBox="0 0 24 24">
                <circle cx="8" cy="15.5" r="4.4" />
                <circle cx="12.2" cy="10.6" r="3.3" />
                <circle cx="15.5" cy="6.8" r="2.3" />
              </svg>
            )}
          </span>
          <h3>{outil.titre}</h3>
          <p>{outil.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section-outils" aria-labelledby="titre-course">
    <h2 id="titre-course">
      <svg class="titre-icone" viewBox="0 0 24 24" aria-hidden="true"><path d="M13 3 5 14h6l-1 7 9-11h-6z" /></svg>
      Course
    </h2>
    <div class="grille-outils">
      <a class="carte-outil carte-outil--vedette" href={outilVedette.href}>
        <div class="carte-outil-entete">
          <span class="carte-outil-icone" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="17" rx="2" /><path d="M9 3.5h6a1 1 0 0 1 1 1V6H8V4.5a1 1 0 0 1 1-1z" /><path d="M8.5 12.5l2 2 4-4.5" /></svg>
          </span>
          <span class="carte-outil-badge">Combine les deux outils ci-dessous</span>
        </div>
        <h3>{outilVedette.titre}</h3>
        <p>{outilVedette.description}</p>
      </a>
      {outilsCourse.map((outil) => (
        <a class="carte-outil" href={outil.href}>
          <span class="carte-outil-icone" aria-hidden="true">
            {outil.icone === 'eclair' && (
              <svg viewBox="0 0 24 24"><path d="M13 3 5 14h6l-1 7 9-11h-6z" /></svg>
            )}
            {outil.icone === 'goutte' && (
              <svg viewBox="0 0 24 24"><path d="M12 3c4 5 6.5 8.2 6.5 11.2A6.5 6.5 0 1 1 5.5 14.2C5.5 11.2 8 8 12 3z" /></svg>
            )}
          </span>
          <h3>{outil.titre}</h3>
          <p>{outil.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section-profil">
    <div class="bandeau-profil">
      <div>
        <h2>Votre profil, votre garage</h2>
        <p>
          Renseignez-les une fois : FTP, poids, vélos enregistrés… ils préremplissent ensuite les
          calculateurs ci-dessus. Tout reste stocké uniquement dans votre navigateur.
        </p>
      </div>
      <div class="liens-profil">
        <a href="/profil" class="bouton-secondaire">Mon profil</a>
        <a href="/mon-garage" class="bouton-secondaire">Mon garage</a>
      </div>
    </div>
  </section>

  <section class="section-contenu">
    <h2>Contenu</h2>
    <p>
      Au-delà des outils, le <a href="/blog">blog</a> rassemble des articles de fond sourcés — un {' '}
      <a href="/blog/glossaire-performance-cycliste">glossaire des sigles de la performance</a>, des guides sur le {' '}
      <a href="/blog/estimer-son-ftp-guide">FTP</a>, la {' '}
      <a href="/blog/reserve-w-prime-guide">réserve W'</a>, la {' '}
      <a href="/blog/crr-cda-guide">résistance au roulement et l'aérodynamisme</a>, l'<a href="/blog/checklist-entretien-preventif">entretien préventif</a>, les {' '}
      <a href="/blog/route-gravel-vtt-ville-reglages">différences entre pratiques</a>, et la {' '}
      <a href="/blog/hydratation-nutrition-entrainement">nutrition à l'entraînement</a>. Pour savoir comment ces outils et ces articles sont construits et vérifiés, voir la page {' '}
      <a href="/methodologie">méthodologie</a>.
    </p>
  </section>
</BaseLayout>
