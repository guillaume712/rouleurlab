---
// Layout de base : squelette HTML commun à toutes les pages.
// Chaque page doit fournir un title et une description uniques (Phase 6 §9 — SEO technique).
interface Props {
  title: string;
  description: string;
  /** Chemin de l'image de partage (Open Graph/Twitter), relatif au site. Par défaut : og-image.png. */
  image?: string;
}

const { title, description, image = '/og-image.png' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);

// Étape 9 — schéma WebSite minimal (nom + url), pour aider les moteurs de
// recherche à identifier le site. Pas de SearchAction : il n'y a pas de
// recherche interne sur le site, on n'invente pas une fonctionnalité qui
// n'existe pas.
const jsonLdSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'RouleurLab',
  url: Astro.site?.toString(),
  inLanguage: 'fr-FR',
};

const cfAnalyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
const sentryDsn = import.meta.env.PUBLIC_SENTRY_DSN;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Twitter — partage sur réseaux sociaux et messageries. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RouleurLab" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLdSite)} />

    <!--
      TEMPORAIRE : en attendant l'achat du nom de domaine réel (rouleurlab.fr),
      le site est déployé sur le sous-domaine gratuit rouleurlab.pages.dev, qui
      N'EST PAS exclu de l'indexation par défaut (vérifié sur la doc Cloudflare
      Pages — seuls les liens de preview aléatoires le sont, pas le sous-domaine
      de production). On bloque donc explicitement l'indexation ici pour éviter
      qu'une URL provisoire soit indexée puis dilue le référencement du vrai
      domaine plus tard.
      À RETIRER à l'Étape 9/11 (lancement sur le vrai domaine), en même temps
      que la restauration de public/robots.txt et l'ajout de la ligne Sitemap.
    -->
    <meta name="robots" content="noindex, nofollow" />

    <!--
      Cloudflare Web Analytics — script chargé UNIQUEMENT si un token est
      renseigné (variable d'environnement PUBLIC_CF_ANALYTICS_TOKEN, vide par
      défaut). Outil sans cookie ni empreinte individuelle côté client
      (source : cloudflare.com/trust-hub/gdpr, consulté le 19/08/2026) — voir
      /confidentialite pour le détail et les nuances.
    -->
    {
      cfAnalyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cfAnalyticsToken })}
        />
      )
    }
  </head>
  <body>
    <header class="site-header">
      <nav>
        <a href="/" class="logo">RouleurLab</a>
        <a href="/profil">Mon profil</a>
        <a href="/mon-garage">Mon garage</a>
        <a href="/blog">Blog</a>
        <a href="/methodologie">Méthodologie</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>RouleurLab — outils gratuits pour cyclistes.</p>
      <p class="liens-legaux">
        <a href="/mentions-legales">Mentions légales</a>
        <a href="/confidentialite">Confidentialité</a>
        <a href="/contact">Contact</a>
      </p>
    </footer>

    <!--
      Sentry — suivi d'erreurs, chargé UNIQUEMENT si un DSN est renseigné
      (variable d'environnement PUBLIC_SENTRY_DSN, vide par défaut : rien
      n'est envoyé à Sentry tant qu'elle ne l'est pas). Importé depuis un CDN
      (esm.sh) plutôt que depuis le package npm : un script utilisant
      define:vars est toujours traité par Astro comme is:inline (non
      empaqueté par Vite), donc un import npm classique n'y fonctionnerait
      pas — voir la doc Astro sur le traitement des scripts client. Épinglé
      sur la branche majeure 10 (dernière branche stable au 19/08/2026, cf.
      npmjs.com/package/@sentry/browser) pour éviter qu'une mise à jour
      majeure change silencieusement le comportement. Voir /confidentialite.
    -->
    {
      sentryDsn && (
        <script define:vars={{ sentryDsn }} is:inline>
          import('https://esm.sh/@sentry/browser@10').then(({ init }) => {
            init({ dsn: sentryDsn, tracesSampleRate: 0 });
          });
        </script>
      )
    }

    <style is:global>
      :root {
        --color-bg: #0f1216;
        --color-text: #e8ebee;
        --color-accent: #ffb020;
        --color-muted: #9aa4af;
        font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--color-bg);
        color: var(--color-text);
        line-height: 1.5;
      }
      main {
        max-width: 960px;
        margin: 0 auto;
        padding: 1.5rem;
      }
      .site-header {
        border-bottom: 1px solid #24282e;
        padding: 1rem 1.5rem;
      }
      nav {
        display: flex;
        align-items: center;
        gap: 1.25rem;
      }
      .logo {
        color: var(--color-accent);
        font-weight: 700;
        text-decoration: none;
        font-size: 1.25rem;
      }
      .site-footer {
        text-align: center;
        color: var(--color-muted);
        padding: 2rem;
        font-size: 0.875rem;
      }
      .liens-legaux {
        display: flex;
        justify-content: center;
        gap: 1rem;
        margin-top: 0.5rem;
      }
      a {
        color: var(--color-accent);
      }

      /* Styles de formulaire partagés (profil, garage, futurs outils). */
      form {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        max-width: 480px;
      }
      .champ {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
      }
      .champ-double {
        flex-direction: row;
        gap: 1rem;
      }
      .champ-double > div {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
      }
      label {
        font-weight: 600;
        font-size: 0.9rem;
      }
      input,
      select {
        background: #1a1e24;
        border: 1px solid #2e333a;
        color: var(--color-text);
        border-radius: 6px;
        padding: 0.5rem 0.6rem;
        font-size: 1rem;
      }
      input[aria-invalid='true'] {
        border-color: #e05555;
      }
      button {
        background: var(--color-accent);
        color: #14171b;
        border: none;
        border-radius: 6px;
        padding: 0.6rem 1rem;
        font-weight: 700;
        cursor: pointer;
        align-self: flex-start;
      }
      button[type='button'] {
        background: transparent;
        color: var(--color-text);
        border: 1px solid #2e333a;
        margin-left: 0.5rem;
      }
      .aide {
        color: var(--color-muted);
        font-size: 0.8rem;
        margin: 0;
      }
      .erreur {
        color: #e05555;
        font-size: 0.8rem;
        margin: 0;
      }
      .confirmation {
        color: #5ac26a;
        font-weight: 600;
      }
      .liste-velos {
        list-style: none;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin: 0 0 1.5rem;
      }
      .liste-velos li {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.6rem 0.75rem;
        background: #1a1e24;
        border-radius: 6px;
      }
      .liste-velos li span {
        flex: 1;
      }

      /* Styles partagés des pages outil (tableaux de référence, avertissements). */
      .avertissement {
        border: 1px solid #7a5a1a;
        background: #201a0e;
        border-radius: 8px;
        padding: 0.9rem 1.1rem;
        margin: 1.25rem 0;
        font-size: 0.9rem;
      }
      .avertissement strong {
        color: var(--color-accent);
      }
      .filtre-recherche {
        width: 100%;
        max-width: 360px;
        margin-bottom: 1rem;
      }
      .table-reference-conteneur {
        overflow-x: auto;
      }
      table.table-reference {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
      }
      table.table-reference caption {
        text-align: left;
        color: var(--color-muted);
        font-size: 0.8rem;
        margin-bottom: 0.5rem;
      }
      table.table-reference th,
      table.table-reference td {
        text-align: left;
        padding: 0.55rem 0.7rem;
        border-bottom: 1px solid #24282e;
        vertical-align: top;
      }
      table.table-reference th {
        color: var(--color-muted);
        font-weight: 600;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.02em;
      }
      table.table-reference td.valeur {
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
        color: var(--color-accent);
        font-weight: 600;
      }
      table.table-reference .note {
        display: block;
        color: var(--color-muted);
        font-size: 0.8rem;
        margin-top: 0.25rem;
      }

      /* Résultat d'un calculateur (longueur de chaîne, et outils suivants). */
      .resultat {
        margin-top: 1.5rem;
        padding: 1rem 1.25rem;
        border: 1px solid #2e333a;
        border-radius: 8px;
        background: #161a1f;
      }
      .resultat-principal {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--color-accent);
        margin: 0 0 0.5rem;
      }
      .resultat .aide {
        margin-top: 0.4rem;
      }
    </style>
  </body>
</html>
