---
// Layout de base : squelette HTML commun à toutes les pages.
// Chaque page doit fournir un title et une description uniques (Phase 6 §9 — SEO technique).
interface Props {
  title: string;
  description: string;
  /** Chemin de l'image de partage (Open Graph/Twitter), relatif au site. Par défaut : og-image.png. */
  image?: string;
}

const { title, description, image = '/og-image.png' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);

// Étape 9 — schéma WebSite minimal (nom + url), pour aider les moteurs de
// recherche à identifier le site. Pas de SearchAction : il n'y a pas de
// recherche interne sur le site, on n'invente pas une fonctionnalité qui
// n'existe pas.
const jsonLdSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'RouleurLab',
  url: Astro.site?.toString(),
  inLanguage: 'fr-FR',
};

const sentryDsn = import.meta.env.PUBLIC_SENTRY_DSN;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Twitter — partage sur réseaux sociaux et messageries. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RouleurLab" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLdSite)} />

    <!--
      Cloudflare Web Analytics : PAS de script manuel ici. Depuis que
      rouleurlab.fr est une zone DNS Cloudflare à part entière, Cloudflare
      injecte automatiquement son propre script de mesure d'audience côté
      edge (réglage "Web Analytics" > RUM automatique sur la zone) —
      indépendamment du code de ce site. Un script manuel ici ferait doublon.
      Voir /confidentialite pour le détail et les nuances.
    -->
  </head>
  <body>
    <header class="site-header">
      <nav>
        <a href="/" class="logo">RouleurLab</a>
        <div class="nav-liens">
          <a href="/profil">Mon profil</a>
          <a href="/mon-garage">Mon garage</a>
          <a href="/blog">Blog</a>
          <a href="/methodologie">Méthodologie</a>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>RouleurLab — outils gratuits pour cyclistes.</p>
      <p class="liens-legaux">
        <a href="/mentions-legales">Mentions légales</a>
        <a href="/confidentialite">Confidentialité</a>
        <a href="/contact">Contact</a>
      </p>
    </footer>

    <!--
      Sentry — suivi d'erreurs, chargé UNIQUEMENT si un DSN est renseigné
      (variable d'environnement PUBLIC_SENTRY_DSN, vide par défaut : rien
      n'est envoyé à Sentry tant qu'elle ne l'est pas). Importé depuis un CDN
      (esm.sh) plutôt que depuis le package npm : un script utilisant
      define:vars est toujours traité par Astro comme is:inline (non
      empaqueté par Vite), donc un import npm classique n'y fonctionnerait
      pas — voir la doc Astro sur le traitement des scripts client. Épinglé
      sur la branche majeure 10 (dernière branche stable au 19/08/2026, cf.
      npmjs.com/package/@sentry/browser) pour éviter qu'une mise à jour
      majeure change silencieusement le comportement. Voir /confidentialite.
    -->
    {
      sentryDsn && (
        <script define:vars={{ sentryDsn }} is:inline>
          import('https://esm.sh/@sentry/browser@10').then(({ init }) => {
            init({ dsn: sentryDsn, tracesSampleRate: 0 });
          });
        </script>
      )
    }

    <style is:global>
      :root {
        --color-bg: #f5f3fc;
        --color-surface: #ffffff;
        --color-surface-tint: #f1eefb;
        --color-text: #1c1a27;
        --color-accent: #5b4fe0;
        --color-accent-2: #8b7ff5;
        --color-ink: #15131f;
        --color-muted: #6d6b80;
        --color-succes: #1fa971;
        --color-erreur: #e2483f;
        --font-body: 'Inter', system-ui, -apple-system, "Segoe UI", sans-serif;
        --font-titre: 'Sora', 'Inter', system-ui, sans-serif;
        --ombre-carte: 0 1px 2px rgba(21, 19, 31, 0.04), 0 12px 28px -16px rgba(91, 79, 224, 0.22);
        --ombre-carte-survol: 0 2px 4px rgba(21, 19, 31, 0.06), 0 20px 36px -16px rgba(91, 79, 224, 0.32);
        font-family: var(--font-body);
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background:
          radial-gradient(1100px 560px at 12% -10%, rgba(139, 127, 245, 0.3), transparent 60%),
          radial-gradient(900px 480px at 105% 0%, rgba(91, 79, 224, 0.16), transparent 55%),
          var(--color-bg);
        background-attachment: fixed;
        color: var(--color-text);
        line-height: 1.5;
      }
      h1, h2, h3 {
        font-family: var(--font-titre);
        letter-spacing: -0.01em;
      }
      main {
        max-width: 960px;
        margin: 0 auto;
        padding: 1.5rem;
      }
      .site-header {
        position: sticky;
        top: 1rem;
        z-index: 20;
        max-width: 960px;
        margin: 1rem auto 0;
        padding: 0.7rem 1.5rem;
        background: rgba(255, 255, 255, 0.93);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(21, 19, 31, 0.06);
        border-radius: 999px;
        box-shadow: 0 10px 28px -14px rgba(91, 79, 224, 0.3);
      }
      nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
      }
      .nav-liens {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        flex-wrap: wrap;
      }
      nav a {
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
        transition: color 0.15s ease;
      }
      nav a:hover {
        color: var(--color-accent);
      }
      .logo {
        font-family: var(--font-titre);
        color: var(--color-accent);
        font-weight: 700;
        text-decoration: none;
        font-size: 1.3rem;
        letter-spacing: -0.01em;
      }
      .site-footer {
        text-align: center;
        color: var(--color-muted);
        padding: 2rem;
        font-size: 0.875rem;
      }
      .liens-legaux {
        display: flex;
        justify-content: center;
        gap: 1rem;
        margin-top: 0.5rem;
      }
      a {
        color: var(--color-accent);
      }

      /* Accueil — hero, cartes d'outils par catégorie, bandeau profil. */
      .hero-carte {
        background: linear-gradient(165deg, #ffffff, var(--color-surface-tint) 75%);
        border: 1px solid rgba(21, 19, 31, 0.06);
        border-radius: 28px;
        padding: 3rem 2rem;
        box-shadow: var(--ombre-carte);
        text-align: center;
        margin-top: 1rem;
      }
      .hero h1 {
        font-size: 2.5rem;
        margin: 0 auto 0.75rem;
        max-width: 30rem;
      }
      .hero-intro {
        color: var(--color-muted);
        font-size: 1.05rem;
        max-width: 34rem;
        margin: 0 auto;
      }
      .hero-cta {
        display: flex;
        justify-content: center;
        gap: 0.9rem;
        margin-top: 1.75rem;
        flex-wrap: wrap;
      }
      .section-outils {
        margin-top: 2.5rem;
      }
      .section-outils h2,
      .section-profil h2,
      .section-contenu h2 {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        font-size: 1.15rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: var(--color-muted);
        margin: 0 0 1rem;
      }
      .titre-icone {
        width: 1.1rem;
        height: 1.1rem;
        color: var(--color-accent);
      }
      .grille-outils {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 1rem;
      }
      .carte-outil {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        padding: 1.25rem;
        background: var(--color-surface);
        border: 1px solid rgba(21, 19, 31, 0.07);
        border-radius: 16px;
        text-decoration: none;
        color: var(--color-text);
        box-shadow: var(--ombre-carte);
        transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
      }
      .carte-outil:hover {
        border-color: var(--color-accent);
        transform: translateY(-3px);
        box-shadow: var(--ombre-carte-survol);
      }
      .carte-outil h3 {
        margin: 0;
        font-size: 1.05rem;
        color: var(--color-text);
      }
      .carte-outil p {
        margin: 0;
        color: var(--color-muted);
        font-size: 0.88rem;
        line-height: 1.5;
      }
      .carte-outil-icone {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 50%;
        background: linear-gradient(160deg, var(--color-accent-2), var(--color-accent));
        color: #fff;
        box-shadow: 0 8px 16px -8px rgba(91, 79, 224, 0.6);
      }
      .carte-outil-icone svg {
        width: 1.6rem;
        height: 1.6rem;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.6;
        stroke-linecap: round;
        stroke-linejoin: round;
      }
      .carte-outil--vedette {
        border-color: var(--color-accent);
        background: linear-gradient(160deg, var(--color-surface-tint), var(--color-surface) 70%);
      }
      .carte-outil-entete {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        flex-wrap: wrap;
      }
      .carte-outil-badge {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: #fff;
        background: var(--color-accent);
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
      }
      .section-profil {
        margin-top: 2.5rem;
      }
      .bandeau-profil {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        padding: 1.25rem 1.5rem;
        background: var(--color-surface);
        border: 1px solid rgba(21, 19, 31, 0.07);
        border-radius: 16px;
        box-shadow: var(--ombre-carte);
      }
      .bandeau-profil h2 {
        margin: 0 0 0.4rem;
        text-transform: none;
        letter-spacing: normal;
        font-size: 1.1rem;
        color: var(--color-text);
      }
      .bandeau-profil p {
        margin: 0;
        color: var(--color-muted);
        font-size: 0.9rem;
        max-width: 34rem;
      }
      .liens-profil {
        display: flex;
        gap: 0.75rem;
        flex-shrink: 0;
      }
      .bouton-secondaire {
        display: inline-block;
        text-decoration: none;
        color: var(--color-text);
        border: 1px solid rgba(21, 19, 31, 0.14);
        border-radius: 999px;
        padding: 0.55rem 1.1rem;
        font-weight: 600;
        font-size: 0.9rem;
        white-space: nowrap;
        transition: border-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
      }
      .bouton-secondaire:hover {
        border-color: var(--color-accent);
        color: var(--color-accent);
        transform: translateY(-1px);
      }
      .bouton-principal {
        display: inline-block;
        text-decoration: none;
        background: var(--color-ink);
        color: #fff;
        border-radius: 999px;
        padding: 0.7rem 1.4rem;
        font-weight: 700;
        font-size: 0.95rem;
        white-space: nowrap;
        box-shadow: 0 12px 24px -10px rgba(21, 19, 31, 0.45);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
      }
      .bouton-principal:hover {
        transform: translateY(-1px);
        box-shadow: 0 16px 28px -10px rgba(21, 19, 31, 0.55);
      }
      .section-contenu {
        margin-top: 2.5rem;
      }

      /* Blog — grille de cartes (même langage visuel que les cartes d'outils). */
      .grille-articles {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 1rem;
        margin-top: 1.5rem;
      }
      .carte-article {
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
        padding: 1.25rem;
        background: var(--color-surface);
        border: 1px solid rgba(21, 19, 31, 0.07);
        border-radius: 16px;
        text-decoration: none;
        color: var(--color-text);
        box-shadow: var(--ombre-carte);
        transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
      }
      .carte-article:hover {
        border-color: var(--color-accent);
        transform: translateY(-3px);
        box-shadow: var(--ombre-carte-survol);
      }
      .carte-article h3 {
        margin: 0;
        font-size: 1.05rem;
        color: var(--color-text);
      }
      .carte-article p {
        margin: 0;
        color: var(--color-muted);
        font-size: 0.88rem;
        line-height: 1.5;
      }
      .carte-article-date {
        font-size: 0.78rem !important;
        text-transform: uppercase;
        letter-spacing: 0.02em;
      }

      /* Styles de formulaire partagés (profil, garage, futurs outils). */
      form {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        max-width: 480px;
      }
      .champ {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
      }
      .champ-double {
        flex-direction: row;
        gap: 1rem;
      }
      .champ-double > div {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
      }
      label {
        font-weight: 600;
        font-size: 0.9rem;
      }
      input,
      select {
        background: var(--color-surface);
        border: 1px solid rgba(21, 19, 31, 0.12);
        color: var(--color-text);
        border-radius: 10px;
        padding: 0.55rem 0.7rem;
        font-size: 1rem;
        font-family: inherit;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
      }
      input:focus,
      select:focus {
        outline: none;
        border-color: var(--color-accent);
        box-shadow: 0 0 0 3px rgba(91, 79, 224, 0.16);
      }
      input[aria-invalid='true'] {
        border-color: var(--color-erreur);
      }
      input[type='file'] {
        background: transparent;
        border: none;
        padding: 0.2rem 0;
        font-size: 0.88rem;
        color: var(--color-muted);
      }
      input[type='file']::file-selector-button {
        background: var(--color-ink);
        color: #fff;
        border: none;
        border-radius: 999px;
        padding: 0.55rem 1.15rem;
        font-weight: 700;
        font-size: 0.85rem;
        font-family: inherit;
        cursor: pointer;
        margin-right: 0.85rem;
        box-shadow: 0 8px 18px -10px rgba(21, 19, 31, 0.4);
        transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
      }
      input[type='file']::file-selector-button:hover {
        background: #26222f;
        transform: translateY(-1px);
      }
      input[type='file']:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 3px;
        border-radius: 999px;
      }
      fieldset {
        margin: 0;
        border: 1px solid rgba(21, 19, 31, 0.1);
        border-radius: 16px;
        padding: 1.15rem 1.25rem 1.3rem;
        background: var(--color-surface);
        box-shadow: var(--ombre-carte);
      }
      fieldset > legend {
        padding: 0 0.5rem;
        margin-left: -0.5rem;
        font-family: var(--font-titre);
        font-weight: 700;
        font-size: 0.95rem;
        color: var(--color-text);
      }
      button {
        background: var(--color-ink);
        color: #fff;
        border: none;
        border-radius: 999px;
        padding: 0.65rem 1.3rem;
        font-weight: 700;
        cursor: pointer;
        align-self: flex-start;
        box-shadow: 0 10px 24px -10px rgba(21, 19, 31, 0.4);
        transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
      }
      button:hover {
        background: #26222f;
        transform: translateY(-1px);
        box-shadow: 0 14px 28px -10px rgba(21, 19, 31, 0.5);
      }
      button:active {
        transform: translateY(0);
      }
      button[type='button'] {
        background: transparent;
        color: var(--color-text);
        border: 1px solid rgba(21, 19, 31, 0.14);
        margin-left: 0.5rem;
        box-shadow: none;
      }
      button[type='button']:hover {
        background: transparent;
        border-color: var(--color-accent);
        color: var(--color-accent);
        box-shadow: none;
      }
      .aide {
        color: var(--color-muted);
        font-size: 0.8rem;
        margin: 0;
      }
      .erreur {
        color: var(--color-erreur);
        font-size: 0.8rem;
        margin: 0;
      }
      .confirmation {
        color: var(--color-succes);
        font-weight: 600;
      }
      .liste-velos {
        list-style: none;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin: 0 0 1.5rem;
      }
      .liste-velos li {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.6rem 0.75rem;
        background: var(--color-surface-tint);
        border: 1px solid rgba(21, 19, 31, 0.05);
        border-radius: 10px;
      }
      .liste-velos li span {
        flex: 1;
      }

      /* Styles partagés des pages outil (tableaux de référence, avertissements). */
      .entete-outil {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1rem;
      }
      .entete-outil h1 {
        margin: 0;
      }
      .avertissement {
        border: 1px solid rgba(91, 79, 224, 0.18);
        border-left: 3px solid var(--color-accent);
        background: var(--color-surface-tint);
        border-radius: 12px;
        padding: 0.9rem 1.1rem;
        margin: 1.25rem 0;
        font-size: 0.9rem;
        box-shadow: var(--ombre-carte);
      }
      .avertissement strong {
        color: var(--color-accent);
      }
      .filtre-recherche {
        width: 100%;
        max-width: 360px;
        margin-bottom: 1rem;
      }
      .table-reference-conteneur {
        overflow-x: auto;
      }
      table.table-reference {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
      }
      table.table-reference caption {
        text-align: left;
        color: var(--color-muted);
        font-size: 0.8rem;
        margin-bottom: 0.5rem;
      }
      table.table-reference th,
      table.table-reference td {
        text-align: left;
        padding: 0.6rem 0.75rem;
        border-bottom: 1px solid rgba(21, 19, 31, 0.06);
        vertical-align: top;
      }
      table.table-reference th {
        color: var(--color-muted);
        font-weight: 600;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.02em;
        border-bottom: 1px solid rgba(21, 19, 31, 0.14);
      }
      table.table-reference tbody tr {
        transition: background-color 0.1s ease;
      }
      table.table-reference tbody tr:hover {
        background-color: rgba(91, 79, 224, 0.05);
      }
      table.table-reference td.valeur {
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
        color: var(--color-accent);
        font-weight: 600;
      }
      table.table-reference .note {
        display: block;
        color: var(--color-muted);
        font-size: 0.8rem;
        margin-top: 0.25rem;
      }

      /* Résultat d'un calculateur (longueur de chaîne, et outils suivants). */
      .resultat {
        margin-top: 1.5rem;
        padding: 1rem 1.25rem;
        border: 1px solid rgba(21, 19, 31, 0.07);
        border-left: 4px solid var(--color-muted);
        border-radius: 14px;
        background: var(--color-surface);
        box-shadow: var(--ombre-carte);
      }
      .resultat-principal {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--color-accent);
        margin: 0 0 0.5rem;
      }
      .resultat .aide {
        margin-top: 0.4rem;
      }
      .resultat--recommande {
        border-left-color: var(--color-succes);
      }
      .resultat--recommande .resultat-principal {
        color: var(--color-succes);
      }
      .resultat--tolere {
        border-left-color: var(--color-accent);
      }
      .resultat--non-recommande {
        border-left-color: var(--color-erreur);
      }
      .resultat--non-recommande .resultat-principal {
        color: var(--color-erreur);
      }
      .resultat--hors-couverture {
        border-left-color: var(--color-muted);
      }
      .resultat--hors-couverture .resultat-principal {
        color: var(--color-muted);
      }
    </style>
  </body>
</html>
