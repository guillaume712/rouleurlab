# Copiez ce fichier en .env (déjà ignoré par git) pour du développement local.
# En production (Cloudflare Pages), ces mêmes variables se renseignent dans les
# réglages du projet : Settings > Environment variables.
#
# Toutes deux sont optionnelles : en leur absence, aucun script correspondant
# n'est chargé (voir src/layouts/BaseLayout.astro) et rien n'est envoyé au
# service tiers concerné. Voir /confidentialite pour le détail.

# Cloudflare Web Analytics — token du site (tableau de bord Cloudflare >
# Analytics & Logs > Web Analytics > votre site > Manage site > Copy code snippet).
PUBLIC_CF_ANALYTICS_TOKEN=

# Sentry — DSN du projet (Sentry > Settings > Projects > votre projet > Client Keys / DSN).
PUBLIC_SENTRY_DSN=
